{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "draisabelabertoglio.vercel.app"
        }
      ],
      "destination": "https://www.draisabelabertoglio.com.br/:path",
      "permanent": true
    },
    {
      "source": "/nutrologia/:path+",
      "destination": "/nutrologia",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(o-que-e-reumatismo|o-que-um-medico-reumatologista-pode-fazer-pela-minha-saude-2|reumatismo-nao-e-coisa-de-velho-2|quando-devo-procurar-um-reumatologista-2|doencas-reumatologicas-diagnostico-e-tratamento|fibromialgia-e-doencas-articulares-inflamatorias-como-diferenciar|conheca-os-tipos-de-reumatismo-mais-comuns-2|category|wp-content|wp-admin|wp-includes)(/.*)?",
      "destination": "/api/gone"
    },
    {
      "source": "/(wp-[^/]*\\.php|xmlrpc\\.php)",
      "destination": "/api/gone"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|avif|jpg|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
